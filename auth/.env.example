AUTH_SERVER_PORT=8082
AUTH_DB_URL=jdbc:postgresql://127.0.0.1:5435/meetingmind_auth
AUTH_DB_RUNTIME_PASSWORD=replace-with-local-runtime-password
AUTH_DB_MIGRATION_USER=meetingmind_auth_migrator
AUTH_DB_MIGRATION_PASSWORD=replace-with-local-migration-password
AUTH_REFRESH_HASH_SECRET=replace-with-at-least-32-random-characters
AUTH_PASSWORD_BCRYPT_COST=12
AUTH_GOOGLE_CLIENT_IDS=replace-with-google-client-id
AUTH_BFF_SPIFFE_PRINCIPALS=spiffe://meetingmind.internal/ns/meetingmind/sa/meetingmind-bff
AUTH_JWKS_SPIFFE_PRINCIPALS=spiffe://meetingmind.internal/ns/meetingmind/sa/meetingmind-bff,spiffe://meetingmind.internal/ns/meetingmind/sa/meetingmind-core,spiffe://meetingmind.internal/ns/meetingmind/sa/meetingmind-ai,spiffe://meetingmind.internal/ns/meetingmind/sa/meetingmind-livekit
AUTH_ALLOW_TEST_WORKLOAD_HEADER=true
AUTH_SIGNING_PROVIDER=disabled
AUTH_SIGNING_ISSUER=https://auth.meetingmind.internal
AUTH_SIGNING_KEY_RING_JSON=
