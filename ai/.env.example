AI_TEXT_PROVIDER=openai
AI_TEXT_BASE_URL=http://llm.internal:8000/v1
AI_TEXT_API_KEY=local-provider-token
AI_TEXT_MODEL=local-model
AI_TEXT_API_STYLE=responses
AI_TEXT_STREAM=false
AI_TEXT_STREAM_OPTIONS_INCLUDE_USAGE=false
AI_TEXT_RESPONSE_FORMAT_MODE=json_schema
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_BASE_URL=http://embedding.internal:8001/v1
AI_EMBEDDING_API_KEY=local-provider-token
AI_EMBEDDING_MODEL=local-embedding-model
AI_EMBEDDING_DIMENSION=1536
AI_EMBEDDING_INCLUDE_DIMENSIONS=false
AI_VECTOR_DIMENSION=1536
# Canonical OpenAI key. OPEN_AI_KEY is accepted only for legacy local compatibility.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_INCLUDE_DIMENSIONS=true
AI_DATABASE_URL=postgresql://meetingmind:meetingmind_local@localhost:5434/meetingmind
ONPREM_POC_RAG_QUERY=온프레 AI PoC 출시 일정과 QA 마감
ONPREM_POC_PROJECT_ID=smoke-space
ONPREM_POC_ALLOWED_MEETING_IDS=smoke-meeting
ONPREM_POC_REQUIRE_RETRIEVAL=false
ONPREM_POC_RESULT_PATH=
AI_INTERNAL_SERVICE_TOKEN=replace-with-a-local-service-token
AI_QUEUE_OBSERVATION_SECONDS=60
AI_HOST=0.0.0.0
AI_PORT=8000
