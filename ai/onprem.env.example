# MeetingMind on-prem AI PoC template.
# Copy to ai/.env or pass to `./onprem_poc_run.sh ./onprem.env`.
# Replace endpoint, model, token, and database values for the actual on-prem environment.
# This template is accepted for preflight-only checks, but final smoke/validator rejects placeholder model names.

AI_TEXT_PROVIDER=local-openai-compatible
AI_TEXT_BASE_URL=http://localhost:8001/v1
AI_TEXT_API_KEY=local-provider-token
AI_TEXT_MODEL=local-llm-model
AI_TEXT_API_STYLE=chat-completions
AI_TEXT_STREAM=true
AI_TEXT_STREAM_OPTIONS_INCLUDE_USAGE=false
AI_TEXT_RESPONSE_FORMAT_MODE=json_schema

AI_EMBEDDING_PROVIDER=local-openai-compatible
AI_EMBEDDING_BASE_URL=http://localhost:8002/v1
AI_EMBEDDING_API_KEY=local-provider-token
AI_EMBEDDING_MODEL=local-embedding-model
AI_EMBEDDING_DIMENSION=1536
AI_EMBEDDING_INCLUDE_DIMENSIONS=false
AI_VECTOR_DIMENSION=1536

AI_DATABASE_URL=postgresql://meetingmind:meetingmind_local@localhost:5434/meetingmind_onprem_eval
AI_INTERNAL_SERVICE_TOKEN=local-only-ai-service-token

RUN_ONPREM_AI_POC_SMOKE=true
ONPREM_POC_PREFLIGHT_ONLY=false
ONPREM_POC_REQUIRE_RETRIEVAL=true
ONPREM_POC_RESULT_PATH=/tmp/meetingmind-onprem-poc-result.json
ONPREM_POC_RAG_QUERY="온프레 AI PoC 출시 일정과 QA 마감"
ONPREM_POC_PROJECT_ID=smoke-space
ONPREM_POC_ALLOWED_MEETING_IDS=smoke-meeting

# Optional performance gates. Tune per hardware target.
ONPREM_POC_MAX_TTFT_MS=
ONPREM_POC_MAX_TOTAL_MS=
ONPREM_POC_MAX_RETRIEVAL_MS=
ONPREM_POC_MIN_TOKENS_PER_SECOND=
