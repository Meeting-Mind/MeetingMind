BFF_SERVER_PORT=8081
BFF_ACCEPT_BROWSER_TRAFFIC=true
BFF_REDIS_HOST=127.0.0.1
BFF_REDIS_PORT=6380
# ECS/ElastiCache IAM 환경에서만 활성화한다. local은 password 없는 일반 Redis 경계를 유지한다.
# BFF_REDIS_IAM_AUTH_ENABLED=true
# BFF_REDIS_IAM_CACHE_NAME=meetingmind-nonprod-v2-valkey
# BFF_REDIS_AWS_REGION=ap-northeast-2
BFF_SESSION_IDLE_TIMEOUT=60m
BFF_SESSION_COOKIE_NAME=mm-session
BFF_SESSION_COOKIE_SECURE=false
BFF_TOKEN_VAULT_KEY_PROVIDER=local
BFF_TOKEN_VAULT_NAMESPACE=meetingmind:bff:token-vault
BFF_TOKEN_VAULT_LOCAL_KEY_ID=local-development
BFF_TOKEN_VAULT_LOCAL_KEY_BASE64=replace-with-base64-encoded-32-byte-key
BFF_BACKEND_BASE_URL=http://127.0.0.1:8080
BFF_AUTH_PROVIDER=auth-service
BFF_AUTH_ISSUER=https://auth.meetingmind.internal
BFF_AUTH_SERVICE_BASE_URL=http://127.0.0.1:8082
# 로컬/CI profile에서만 Auth/Core의 명시적 test workload header를 허용한다.
BFF_AUTH_ALLOW_TEST_PRINCIPAL_HEADER=true
BFF_AUTH_TEST_PRINCIPAL=spiffe://meetingmind.internal/ns/meetingmind/sa/meetingmind-bff
BFF_CORE_ALLOW_TEST_PRINCIPAL_HEADER=true
BFF_CORE_TEST_PRINCIPAL=spiffe://meetingmind.internal/ns/meetingmind/sa/meetingmind-bff
BFF_CORE_BASE_URL=http://127.0.0.1:8080
BFF_CORE_CONNECT_TIMEOUT=1s
BFF_CORE_READ_TIMEOUT=3s
BFF_CORE_MAX_CONCURRENT=64
BFF_CORE_FAILURE_THRESHOLD=5
BFF_CORE_OPEN_DURATION=30s
BFF_AI_BASE_URL=http://127.0.0.1:8080
BFF_AI_CONNECT_TIMEOUT=1s
BFF_AI_READ_TIMEOUT=30s
BFF_AI_MAX_CONCURRENT=8
BFF_AI_FAILURE_THRESHOLD=3
BFF_AI_OPEN_DURATION=30s
BFF_LIVEKIT_BASE_URL=http://127.0.0.1:8080
BFF_LIVEKIT_CONNECT_TIMEOUT=1s
BFF_LIVEKIT_READ_TIMEOUT=2s
BFF_LIVEKIT_MAX_CONCURRENT=16
BFF_LIVEKIT_FAILURE_THRESHOLD=3
BFF_LIVEKIT_OPEN_DURATION=15s
# 명시적 rollback에서만 사용한다.
# BFF_AUTH_PROVIDER=legacy
# BFF_AUTH_ISSUER=meetingmind-core-legacy
# 운영에서는 local key 대신 KMS provider와 key ARN/alias를 사용한다.
# BFF_TOKEN_VAULT_KEY_PROVIDER=kms
# BFF_TOKEN_VAULT_KMS_KEY_ID=alias/meetingmind-token-vault
