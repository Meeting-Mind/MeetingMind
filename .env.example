# Shared local configuration for Docker Compose and the Backend AI gateway.
# Copy to .env, then replace placeholders. Do not commit the copied file.

# Core PostgreSQL and Redis exposed to the host.
MEETINGMIND_DB_PORT=5434
MEETINGMIND_DB_NAME=meetingmind
MEETINGMIND_DB_USER=meetingmind
MEETINGMIND_DB_PASSWORD=meetingmind_local
MEETINGMIND_REDIS_PORT=6380

# Backend and AI must use the exact same value. Generate once with:
# openssl rand -hex 32
AI_INTERNAL_SERVICE_TOKEN=replace-with-a-local-service-token

# Canonical provider key used by the AI API and embedding worker.
# OPEN_AI_KEY remains a legacy compatibility alias and should not be added here.
OPENAI_API_KEY=replace-with-openai-api-key
AI_TEXT_PROVIDER=openai
AI_TEXT_MODEL=gpt-4.1-mini
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSION=1536
AI_VECTOR_DIMENSION=1536
