# Backend-only local configuration. Shared DB and AI values live in ../.env.
# Copy to backend/.env and replace only the values required by your local setup.

MEETINGMIND_JWT_SECRET=replace-with-a-local-jwt-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id

# LiveKit and public callback address used for STT egress.
LIVEKIT_URL=wss://replace-with-livekit-host
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
PUBLIC_WS_BASE_URL=https://replace-with-your-ngrok-host

# Optional profile and Workspace representative image storage.
# The database stores only the returned delivery URL, never image bytes.
MEETINGMIND_IMAGE_UPLOAD_DIR=.local-uploads/images

# STT provider. Soniox is primary and OpenAI is the fallback.
STT_PROVIDER=soniox-realtime
STT_FALLBACK_PROVIDER=openai-realtime
SONIOX_API_KEY=replace-with-soniox-api-key
SONIOX_REALTIME_MODEL=stt-rt-v5
SONIOX_LANGUAGE=ko

# Use only when Clova STT is selected.
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# AI_INTERNAL_SERVICE_TOKEN and OPENAI_API_KEY are inherited from ../.env.
# Temporary legacy OPEN_AI_KEY is still supported during migration.
